{
  "name": "dialysave",
  "private": true,
  "type": "module",
  "version": "3.0.0",
  "scripts": {
    "install:all": "npm install --prefix frontend --include=dev && npm install --omit=dev --prefix backend",
    "dev": "node scripts/run-mode.js development",
    "prod": "node scripts/run-mode.js production",
    "mode:dev": "node scripts/run-mode.js development",
    "mode:prod": "node scripts/run-mode.js production",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix backend",
    "test": "npm test --prefix backend",
    "lint": "npm run lint --prefix frontend"
  },
  "engines": {
    "node": "20.x"
  }
}
