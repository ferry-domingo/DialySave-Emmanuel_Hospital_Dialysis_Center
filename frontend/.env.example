# Same-origin deployment: leave both values blank.
VITE_API_URL=
VITE_SOCKET_URL=

# Development proxy target. You normally do not need to change this.
VITE_DEV_SERVER_URL=http://localhost:5000

# Separate frontend/backend example:
# VITE_API_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com
