MONGO_URI=mongodb://127.0.0.1:27017/dialysave
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
# Comma-separated frontend origins when frontend and backend are hosted separately.
# Leave blank for a same-origin production deployment.
CLIENT_URL=
ADMIN_EMAIL=temporary.admin@ehdc.local

# Email verification: use Resend HTTPS API or SMTP.
# On Render Free, use the Resend HTTPS API because outbound SMTP is blocked.
RESEND_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EHDC <no-reply@example.com>
