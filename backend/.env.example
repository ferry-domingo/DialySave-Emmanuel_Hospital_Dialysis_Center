MONGO_URI=mongodb://127.0.0.1:27017/dialysave
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
# Comma-separated frontend origins when frontend and backend are hosted separately.
# Leave blank for a same-origin production deployment.
CLIENT_URL=
ADMIN_EMAIL=temporary.admin@ehdc.local

# Recommended on Render Free: Brevo sends over HTTPS because SMTP ports are blocked.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EHDC

# Optional SMTP fallback for local development or hosting that permits SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EHDC <no-reply@example.com>
